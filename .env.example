# Names only. Copy to .env.local and fill in values; .env.local is git-ignored
# and must never be committed. See README "Local setup" and AGENTS.md section 3.
#
# Every test that needs one of these SKIPS when it is absent, so the gate is
# green with none of them set; coverage is complete only when all are present.

# Editor sign-in (D018, D024). SESSION_SECRET: a long random string; it signs the session cookie.
EDITOR_PASSWORD=
SESSION_SECRET=

# Metadata database: Turso/libSQL (D017, D025). Run `npm run db:migrate` after setting these.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Screenshot storage: private Vercel Blob (D017).
BLOB_READ_WRITE_TOKEN=

# Capture: Browserless Function API token (D016, D036).
BROWSERLESS_TOKEN=

# Optional, real-provider capture fixtures (D041); the suites skip without them.
# The durable values are in test/fixtures/capture/host.json.
# CAPTURE_ECHO_FIXTURE_URL=
# CAPTURE_TALL_FIXTURE_URL=
# CAPTURE_MANIFEST_FIXTURE_URL=
# CAPTURE_LINKS_FIXTURE_URL=
# CAPTURE_NETWORK_FIXTURE_URL=
# CAPTURE_NETWORK_HARD_FIXTURE_URL=

# Optional, `npm run smoke` against the deployment (D068). Not needed for the gate.
# PINATA_PRODUCTION_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Never set this anywhere but a local shell (D052). Never in .env.local, never in Vercel.
# PINATA_AUTH_DISABLED=1
