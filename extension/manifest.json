{
  "manifest_version": 3,
  "name": "Pinata capture",
  "short_name": "Pinata",
  "version": "0.1.0",
  "description": "Capture the page you're on — a full-page screenshot and its elements — and send it to Pinata for feedback.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture this page for Pinata",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "debugger", "downloads", "offscreen", "storage"],
  "host_permissions": [
    "https://yourpinata.dev/*",
    "http://127.0.0.1:3100/*",
    "http://localhost:3100/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open Pinata capture"
    }
  }
}
