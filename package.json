{
  "name": "pinata",
  "version": "0.0.0",
  "private": true,
  "description": "pin + annotation + at ya",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "lint": "node scripts/lint.mjs && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm test && npm run docs:check && npm run build && npm run e2e"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.0",
    "@xyflow/react": "12.11.6",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
